{
  "name": "@rtpl/root",
  "private": true,
  "description": "Tool for creating resources",
  "homepage": "https://github.com/swordev/rtpl#readme",
  "bugs": {
    "url": "https://github.com/swordev/rtpl/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Juanra GM",
    "email": "juanrgm724@gmail.com",
    "url": "https://github.com/juanrgm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swordev/rtpl"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "pnpm check:format",
    "check:format": "oxfmt --cache",
    "prepare": "workspace gen",
    "clean:ts": "tsc -b tsconfig.build.json --clean",
    "format": "oxfmt",
    "start": "node packages/cli/lib/bin.js",
    "test": "vitest run",
    "update:deps": "ncu -ws",
    "watch": "tsc -b tsconfig.build.json -w"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@dreamkit/workspace": "^0.4.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.6",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.75.0",
    "rtpl": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engine": {
    "node": ">=24.0.0"
  }
}
